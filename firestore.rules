rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Функция: пайдаланушы жүйеге сәтті кірген бе (Google немесе Анонимді қонақ)
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Ойыншылар профилі және көшбасшылар кестесі (Elo рейтингі)
    // Барлық адамдар көшбасшылар кестесін және профильдерді оқи алады.
    // Авторизацияланған ойыншылар (Google немесе Анонимді) өз деректерін жаза/жаңарта алады.
    match /users/{userId} {
      allow read: if true;
      allow write: if isAuthenticated() && (request.auth.uid == userId || !exists(/databases/$(database)/documents/users/$(userId)));
    }

    // 2. Матчмейкинг кезегі (Matchmaking Queue)
    // Жүйеге кірген (Google немесе Анонимді) кез келген ойыншы кезекке тұра алады,
    // қарсыластарды іздеп, тикет мәртебесін жұптастыру кезінде өңдей алады.
    match /matchmaking/{userId} {
      allow read, write: if isAuthenticated();
    }

    // 3. Дуэль матчы, жеке бөлмелер және раундтар (Matches, Custom Rooms & Rounds)
    // Ойыншылар матч деректерін оқиды, денсаулықты (HP) шегереді, раундтарды ауыстырады
    match /matches/{matchId} {
      allow read, write: if isAuthenticated();

      match /rounds/{roundId} {
        allow read, write: if isAuthenticated();
      }
    }
  }
}

